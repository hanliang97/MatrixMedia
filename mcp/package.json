    "matrixmedia-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "matrixmedia",
    "workbuddy",
    "douyin",
    "video-publish"
  ],
  "author": "lhl",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanliang97/MatrixMedia.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/hanliang97/MatrixMedia/blob/main/docs/mcp.md",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "pnpm": {
    "overrides": {
      "express>proxy-addr": "2.0.8"
    }
  }
